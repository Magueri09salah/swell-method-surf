# ---------------------------------------------------------------------------
# Swell Method Surf — environment variables
# Copy to `.env` for local development. Never commit real values.
# ---------------------------------------------------------------------------

# Neon PostgreSQL — pooled connection (PgBouncer). Used by the app at runtime.
# Neon dashboard -> Connection string -> "Pooled connection".
DATABASE_URL="postgresql://neondb_owner:npg_xijFgB35VzoS@ep-silent-sunset-axq59e05-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require&pgbouncer=true"

# Neon PostgreSQL — direct (unpooled) connection. Used by Prisma Migrate only.
# Neon dashboard -> Connection string -> uncheck "Pooled connection".
DIRECT_URL="postgresql://neondb_owner:npg_xijFgB35VzoS@ep-silent-sunset-axq59e05.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Secret used to sign admin session JWTs (HS256).
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Canonical public origin. Used for metadata, canonical URLs, sitemap and OG tags.
# No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Seed-only variables (used by `npm run db:seed`, never read at runtime)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="coach@swellmethodsurf.com"
SEED_ADMIN_PASSWORD="coach12345678@"
